---
import { getCollection } from 'astro:content';
import { SiteConfig } from '@utils/SiteConfig';
import Layout from '@layouts/Layout.astro';
import FormattedDate from '@partials/formattedDate.astro';
import Header from '@partials/Header.astro';
import Grid from '@components/utils/Grid.astro';
import Navigation from '@partials/Navigation.astro';
import Footer from '@partials/Footer.astro';
---

<Layout props={{ title: SiteConfig.title, description: SiteConfig.description, image: SiteConfig.image }}>

  <Header />
      <main>
        <div class="wrap">
          <section class="home-section intro" id="intro">
            <div class="home-section__heading">
              <h1>hi, i'm <span>fernando</span>.</h1>

              <h2>web designer & webflow developer • <a href="https://viewport-ui.design" title="Viewport UI" target="_blank">½ viewport ui</a> <br> based in florianópolis, brazil</h2>
            </div>
          </section>
        </div>
      </main>

      <Footer />
</Layout>
<style>

  .home-section {
    color: hsla(var(--body-text-color), .7);
    
    h1, h2 {
      font-size: var(--font-size-regular);
      font-weight: 450;
      margin-bottom: var(--spacing-2);
      line-height: 1.6;
      
      span {
        color: hsla(var(--body-text-color), 1);
      }
    }

    h3 {
      font-size: var(--font-size-regular);
      margin-bottom: var(--spacing-4);
      line-height: 1.6;
    }

    p {
      margin-bottom: var(--spacing-2);
    }
  }

  .home-section__heading {
    a {
      transition: .4s;

     &:hover {
      color: hsla(var(--body-text-color), 1);
      transition: .4s;
     } 
    }
  }

  .home-section:not(:first-child) {
    padding: var(--spacing-8) 0;
  }

  .intro {
    padding-top: calc(var(--spacing-8) + 14rem);
  }

  .works-section, .craft-section {
    article {
      height: 100%;

      a {
        position: relative;
        cursor: crosshair;
        width: 100%;
        height: 100%;
        display: block;

         &:hover {
          .overlay {
            opacity: 1;
            transition: .4s;
          }

          h4 { transform: translateY(0); transition: .2s;}
          h5 { transform: translateY(0); transition: .2s;}
        }
      }
    }

    .overlay {
      opacity: 0;
      transition: .4s;
      width: 100%;
      height: 100%;
      position: absolute;
      top: 0;
      left: 0;
      z-index: 1;
      border-radius: var(--radius-md);
      color: hsla(var(--body-background-color), 1);
      padding: var(--spacing-1);
      backdrop-filter: blur(4px);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background: rgba(0, 0, 0, 0.3);


      h4, h5 {
        font-size: var(--font-size-small);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: .2s;
      }

      h4 {
        transform: translateY(-20px);
      }

      h5 {
        transform: translateY(20px);
      }
    }

    figure {
      width: 100%;
      height: 270px;
      overflow: hidden;
      position: relative;
      border-radius: var(--radius-md);
      border: 1px solid rgba(0,0,0,.02);
    }

    img {
      width: 100%;
      height: 100%;
      object-position: top center;
      object-fit: cover;
      display: block;
    }
  }

  main {
    .grid-container {
      margin-bottom: var(--spacing-1);
    }
  }

  .craft-section {
    figure {
      height: 310px;
    }
  }
</style>