---
import Layout from '@layouts/Layout.astro';
import { SiteConfig } from '@utils/SiteConfig';
import Header from '@partials/Header.astro';
import PageHeading from '@partials/PageHeading.astro';
import Footer from '@partials/Footer.astro';
import photos from '@api/photos.json';
---
<Layout props={{ title: `about — ${SiteConfig.title}`, description: SiteConfig.description, image: SiteConfig.image }}>

    <Header />

    <main>
        <PageHeading title="about" description="about me." />
        <section class="wrap">
            <section class="block__content">
                    <article class="content-article">
                        <h4>i'm a designer who crafts modern, thoughtful and real world experiences. i'm working with web design, icon design and development with webflow, framer & astro.</h4>

                        <h4>i love thinking through design, sipping coffee, listening to fuzzy music, and longboarding.</h4>

                        <!-- <figure>
                            <img src="/avatar-frnd.webp" alt="Yo!" class="about-photo">
                        </figure> -->

                        <h4>with 13 years of experience, i started my journey in design as a self-taught professional. i learned html at the age of 12 and have been in love with interfaces ever since.</h4>
                    
                        <h4>throughout my career, i've collaborated with brands such as massey-ferguson, valtra, coca-cola, accenture, petrobras and more.</h4>
                    </article>
            </section>
        </section>

        <section class="wrap-media">
            <section class="mansory">
            {photos.map(photo => (
                <figure>
                <img src={photo.src} alt={photo.alt} loading="lazy" class="scroll-fade" />
                </figure>
            ))}
            </section>
        </section>
    </main>

    <Footer/>
</Layout>

<style>
    .mansory {
        padding-top: 10vh;
        margin-bottom: 8vh;
    }

    .content-article {
        /* h4:nth-child(1), h4:nth-child(2) {
            font-family: var(--title-font);
            font-size: 3rem;
        } */

        h4 {
            font-weight: 400;
        }
    }

    .about-photo {
        margin: var(--spacing-4) 0;
    }

    .download-btn {
        padding: var(--spacing-1);
        background-color: hsla(var(--body-text-color), 1);
        border-radius: var(--radius-md);
        color: hsla(var(--body-background-color), 1);
        cursor: pointer;
        margin: var(--spacing-2) 0;
        display: inline-flex;
        align-items: center;
        font-weight: 600;
        
        i {
            display: inline-block;
            margin-right: calc(var(--spacing-1) / 2);
            height: 18px;

            svg {
                path {
                    stroke: hsla(var(--body-background-color), 1);
                }
            }
        }
    }
</style>