---
import Layout from '@layouts/Layout.astro';
import books from '@api/books.json';
import { SiteConfig } from '@utils/SiteConfig';
import Header from '@partials/Header.astro';
import PageHeading from '@partials/PageHeading.astro';
import Footer from '@partials/Footer.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Todas as imagens em src/assets, indexadas pelo nome do arquivo
const images = import.meta.glob<{ default: ImageMetadata }>(
    '/src/assets/**/*.{webp,png,jpg,jpeg,avif}',
    { eager: true }
);
const coversByName = Object.fromEntries(
    Object.entries(images).map(([path, mod]) => [path.split('/').pop(), mod.default])
);

const booksId = books.map((book, index) => {
    const fileName = book.coverUrl.split('/').pop();
    const cover = coversByName[fileName];
    if (!cover) console.warn(`[readings] capa não encontrada em src/assets: ${fileName}`);
    return { id: index + 1, ...book, cover };
});

const groupedData = booksId.reduce((acc, item) => {
  if (!acc[item.yearRead]) {
    acc[item.yearRead] = [];
  }
  acc[item.yearRead].push(item);
  return acc;
}, {});

const byYear = Object.keys(groupedData).sort((a,b) => b - a);
---
<Layout props={{ title: `readings — ${SiteConfig.title}`, description: SiteConfig.description, image: SiteConfig.image }}>
    
    <Header />

    <main>
        <PageHeading title="readings" description="what I've been reading." />

        <div class="readings__books">
            {byYear.map(year => (
                <section key={year} class="books__year">
                    <div class="wrap-lg">
                        <h5>{year}</h5>
                    
                        <ul class="books__list">
                        {groupedData[year].map(item => (
                            <li class="book" key={item.id}>
                                <figure>
                                    {item.cover && (
                                        <Image
                                            src={item.cover}
                                            alt={`Capa de ${item.title}, de ${item.author}`}
                                            widths={[300, 600, 900]}
                                            sizes="(min-width: 1040px) 300px, (min-width: 780px) 33vw, 50vw"
                                            loading="lazy"
                                        />
                                    )}
                                </figure>
                                <h3>{item.title}</h3>
                                <p>{item.author}</p>

                                {item.status === "reading" ? (
                                    <span class="book__status book__status--reading">
                                        <i>
                                            <svg width="8" height="11" viewBox="0 0 8 11" fill="none">
                                                <path d="M0.672607 0.98291H7.39672V10.9829L4.03466 7.82644L0.672607 10.9829V0.98291Z" fill="black"/>
                                            </svg>
                                        </i>
                                        Reading
                                    </span>
                                ): (
                                    <span class="book__status book__status--finished">
                                        <i>
                                            <svg width="11" height="8" viewBox="0 0 11 8" fill="none">
                                                <path fill-rule="evenodd" clip-rule="evenodd" d="M1.85935 2.80465L0.681152 3.98285L4.21576 7.51746L10.1068 1.62644L8.92857 0.448242L4.21576 5.16105L1.85935 2.80465Z" fill="black"/>
                                            </svg>

                                        </i>
                                        Finished
                                    </span>
                                )}
                            </li>
                        ))}
                        </ul>
                    </div>
                </section>
            ))}
        </div>
    </main>

    <Footer />
</Layout>

<style>

.readings__books {
    padding-top: var(--spacing-4);
    margin-bottom: var(--spacing-4);
}

@media (max-width: 480px) {
    .readings__books {
      padding-top: 0;
    }
  }

.books__year {
    width: 100%;
    margin: 2rem auto 0;
    display: flex;
    flex-direction: column;

    h5 {
        margin-bottom: 1rem;
        padding-right: var(--spacing-2);
        padding-top: var(--spacing-1);
    }
}


.books__list {
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-1);
    padding-left: 0;
}

.book {
    /* max-width: 240px; */
    width: 100%;
    display: flex;
    flex-direction: column;
    position: relative;
    padding: 1rem 1rem 2rem 0;

    &:before {
        content: ""!important;
    }

    img {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: inherit;
    }

    figure {
        margin-bottom: 0;
        transform-origin: left center;
        transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.3s ease;
        overflow: hidden;
        display: block;
        position: relative;
        border-radius: 5px;

        &:hover {
            transform: perspective(800px) rotateY(-25deg);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);

            &:before {
                transform: rotate(45deg) translate(-30px, -30%);
                background: rgba(255, 255, 255, .1);
                transition: .4s;
            }
        }
    }

    figure::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 150%;
        height: 50%;
        z-index: 1;
        pointer-events: none;
        background: rgba(255, 255, 255, 0);
        transform: rotate(45deg) translate(0, 0%);
        filter: blur(4px);
        transition: .4s;
    }

    figure::after {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
        pointer-events: none;
        background: linear-gradient(270deg, rgba(255, 255, 255, 0.12) 0%, rgba(230, 230, 230, 0.18) 6%, rgba(218, 218, 218, 0.04) 8%, rgba(143, 143, 143, 0) 80%, rgba(131, 131, 131, 0.11) 92.5%, rgba(0, 0, 0, 0.2) 93.5%, rgba(115, 115, 115, 0) 95%, rgba(255, 255, 255, 0.02) 99%, rgba(0, 0, 0, 0.2) 99.04%, rgba(0, 0, 0, 0.2) 100%);
        border-radius: 5px;
    }

    h3 {
        margin-top: 1rem;
        margin-bottom: 0;
        padding: 0;
        color: hsla(var(--body-text-color), 1);
        font-size: var(--font-size-regular);
        font-weight: 500;
        text-transform: lowercase;
    }

    p {
        padding: 0;
        margin-bottom: 0;
        color: hsla(var(--body-text-color), .7);
        text-transform: lowercase;
    }
}

.book__status {
    text-transform: capitalize;
    display: inline-block;
    font-size: var(--font-size-small);
    margin: 8px 0;
    text-transform: lowercase;

    i {
        display: inline-block;
        margin-right: .2rem;
    }
}

.book__status--reading {
    color: #ff8400;

    i path {
        fill: #ff8400;
    }
}

.book__status--finished {
    color: hsla(var(--body-text-color), .5);

    i path {
        fill: hsla(var(--body-text-color), .5);
    }
}

@media (max-width: 1040px) {
    .books__list {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (max-width: 780px) {
    .books__list {
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    .book {
        padding: .5rem;
    }
}
</style>