---

const { title, description } = Astro.props;

---

<section class="page__heading">
    <article class="wrap">
      <a href="/" class="back-home">~/</a>
        <h2>{title}</h2>
        <p>{description}</p>
    </article>
</section>

<style>
  .page__heading {
    margin-bottom: var(--spacing-4);
    padding-top: calc(var(--spacing-8) + 14rem);

    .back-home {
      display: block;
      margin-bottom: var(--spacing-2);
      width: max-content;
      color: hsla(var(--body-text-color), .2);
    }

    h2 {
      margin-bottom: calc(var(--spacing-1) / 2);
      font-size: var(--font-size-h2);
    }
  }

  @media (max-width: 480px) {
    .page__heading {
      padding-top: var(--spacing-8);
    }
  }
</style>